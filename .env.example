# Production template. For local development without Redis, set
# CACHE_DRIVER, QUEUE_CONNECTION and SESSION_DRIVER to "database".
APP_NAME="IV Auto"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.example.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivauto
DB_USERNAME=ivauto
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
# Use "s3" when running more than one web server so uploads are shared.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

# "phpredis" is faster if the PHP extension is installed; "predis" needs no extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Audit log (spatie/laravel-activitylog), pruned nightly by the scheduler.
ACTIVITY_LOG_RETENTION_DAYS=365

# Error tracking. Leave the DSNs empty to disable Sentry.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
